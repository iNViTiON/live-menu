# Environment configuration reference for live-menu-cf
#
# Cloudflare Workers use two mechanisms for configuration:
#   - [vars] in wrangler.toml  — non-secret config, committed to the repo
#   - wrangler secret put KEY  — secrets, stored encrypted in CF dashboard
#                                For local dev, put secrets in .dev.vars (gitignored)
#
# Cloudflare resource bindings (D1, R2, Durable Objects, ASSETS) are declared
# in wrangler.toml and do not appear here.

# ── Non-secret config (wrangler.toml [vars]) ──────────────────────────────────

# Public URL of the menu frontend (used for CORS and WebAuthn origin)
FRONTEND_URL=https://menu.example.com

# WebAuthn Relying Party ID — the domain used for passkey registration/auth
WEBAUTHN_RP_ID=example.com

# Human-readable name shown to users during passkey prompts
WEBAUTHN_RP_NAME=Live Menu

# ── Secrets (use `wrangler secret put KEY` for production) ───────────────────
# No application-level secrets are currently required.
# WebAuthn passkeys are stored in D1 and do not require additional API keys.
